# Memoria 构建产物
build/
packaging/build/
packaging/dist/
Package/*
!Package/.gitkeep
/config/ui-settings.json
*.exe
*.obj
*.o
*.pdb
*.ilk

# 临时文件/调试产物（统一放 artifacts/，见 docs/conventions/directory-organization.md）
artifacts/

# 开发期调试日志（统一放 logs/，见 docs/conventions/logging.md）
logs/

# 根级临时调试产物兜底（不应出现，出现即视为违规产物）
/dbg/
/.dbg/
/.cache/
/cdp-*.mjs
/analyze*.mjs
/diag-*.json
/shot-*.png
/test-*.html
/test-*.mjs
/pages.json

# 运行缓存 / IDE 构建残留
.vendor-cache/
.pytest_cache/
cmake-build-debug/

# Python
__pycache__/
*.pyc
*.pyd
.venv/
venv/
*.egg-info/

# IDE
.vscode/
.idea/
*.user

# 模型缓存
models/
*.bin

# 用户知识库（示例除外）
# examples/ 下的 nodes 可以提交，其他不入库

# 示例知识库运行/调试产物（不入库）
docs/example/**/*.bak
docs/example/**/*.log
docs/example/**/.memoria/cache/
docs/example/**/.memoria/pending.yaml
docs/example/**/.memoria/images/
# 本地试用知识库（仅官方样例与 import-test 夹具入库，保护本地隐私，见 import-plan.md M5.3）
docs/example/empty*/
docs/example/导入test/
docs/example/行政法/

# 单次调试脚本
scripts/_tmp_parse.js
