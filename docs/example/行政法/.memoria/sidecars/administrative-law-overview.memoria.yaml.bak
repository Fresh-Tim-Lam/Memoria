schema_version: 1
file: administrative-law-overview.md
knowledge_points:
  - id: administrative-subject
    name: 行政主体
    range:
      start:
        snippet: "## 行政主体"
      end:
        snippet: "行政主体：指依法享有行政职权的，能以自己的名义对外独立行使行政职权的，并能以自己的名义对外独立承担法律责任的国家行政机关或法律法规授权主体。"
  - id: administrative-relative
    name: 行政相对人
    range:
      start:
        snippet: "## 行政相对人"
      end:
        snippet: "行政相对人：指行政主体在行使行政职权或履行行政职责所产生的[[administrative-act|行政行为]]时，所直接针对的公民、法人、其他组织。"
  - id: administrative-third-party
    name: 行政第三人
    range:
      start:
        snippet: "## 行政第三人"
      end:
        snippet: "行政第三人：指行政主体针对行政相对人作出的行政行为有利害关系的其他公民、法人和其他组织"
  - id: basic-principles-of-administrative-law
    name: 行政基本原则
    range:
      start:
        snippet: "## 行政基本原则"
      end:
        snippet: "- 行政效能原则- 行政责任原则"
  - id: lawful-administration-principle
    name: 依法行政原则
    range:
      start:
        snippet: "### 依法行政原则"
      end:
        snippet: "- 职权法定- 法律优先- 法律保留"
  - id: reasonable-administration-principle
    name: 合理行政原则
    range:
      start:
        snippet: "### 合理行政原则"
      end:
        snippet: "- 公平公正- 比例原则：合目的性；适当性（结果或措施与手段之间存在正当性）；损害最小"
  - id: procedural-due-process-principle
    name: 程序正当原则
    range:
      start:
        snippet: "### 程序正当原则"
      end:
        snippet: "- 行政公开- 公众参与- 公务回避"
  - id: good-faith-principle
    name: 诚信原则
    range:
      start:
        snippet: "### 诚信原则"
      end:
        snippet: "- 诚实守信（不得钓鱼执法）- 信赖保护"
  - id: efficiency-and-convenience-principle
    name: 高效便民原则
    range:
      start:
        snippet: "### 高效便民原则"
      end:
        snippet: "- 高效原则- 便民原则"
  - id: unity-of-power-and-responsibility-principle
    name: 权责统一原则
    range:
      start:
        snippet: "### 权责统一原则"
      end:
        snippet: "- 行政效能原则- 行政责任原则"
  - id: administrative-organization
    name: 行政机关
    range:
      start:
        snippet: "## 行政机关"
      end:
        snippet: "行政机关：指依法设置的承担行政事务、实现行政目的并能独立对外进行管理的基本组织体。"
  - id: administrative-establishment
    name: 行政编制
    range:
      start:
        snippet: "## 行政编制"
      end:
        snippet: "- 行政编制：国家系统中从事公共事务的行政机关和其他组织的设置、规格、职能、内部结构、人员规模和机构比例的总和。"
  - id: public-service-establishment
    name: 事业编制
    range:
      start:
        snippet: "## 事业编制"
      end:
        snippet: "事业编制：指政府为了发展社会事业、提供公共服务、增进社会福利，通过国家财力建立的各种事业机构的设置、结构和人员规模的总和。"
  - id: administrative-authorization
    name: 行政授权
    range:
      start:
        snippet: "## 行政授权"
      end:
        snippet: "- 被授权组织：必须是依法成立；与授权机关无利害关系；应具备了解和掌握有关行政法规和技术知识的工作人员；具备履行的设备条件；能独立成立后果"
  - id: administrative-entrustment
    name: 行政委托
    range:
      start:
        snippet: "## 行政委托"
      end:
        snippet: "- 权利来源不同：行政委托是行政主体委托；行政授权是法律法规授予·对外后果不同：行政委托被委托者没有行政主体资格（以委托机关名义承担责任）；行政授权有主体资格，以自己名义承担责任"
  - id: sources-of-administrative-law
    name: 行政法法律渊源
    range:
      start:
        snippet: "## 行政法法律渊源"
      end:
        snippet: "- 地方规章：省政府、设区的市政府"
  - id: administrative-act
    name: 行政行为
    range:
      start:
        snippet: "## 行政行为"
      end:
        snippet: "- 要式和不要式"
  - id: formation-conditions-of-administrative-act
    name: 行政行为成立合法的一般条件
    range:
      start:
        snippet: "## 行政行为成立合法的一般条件"
      end:
        snippet: "- 权限合法"
  - id: validity-of-administrative-act
    name: 行政行为效力
    range:
      start:
        snippet: "## 行政行为效力"
      end:
        snippet: "- 执行力：国家强制力迫使当事人履行义务"
  - id: illegal-administrative-act
    name: 行政行为违法
    range:
      start:
        snippet: "## 行政行为违法"
      end:
        snippet: "- 明显不合理"
  - id: revocation-of-administrative-act
    name: 行政行为撤销
    range:
      start:
        snippet: "## 行政行为撤销"
      end:
        snippet: "- 带来损失的可获赔偿，但因当事人行贿、瞒报等自身违法行为而导致被撤销不赔偿"
  - id: abolition-of-administrative-act
    name: 行政行为废止
    range:
      start:
        snippet: "## 行政行为废止"
      end:
        snippet: "- 后果：自废止之日起失效；造成损失的赔偿"
  - id: invalidity-of-administrative-act
    name: 行政行为无效
    range:
      start:
        snippet: "## 行政行为无效"
      end:
        snippet: "- 可以在任何时候主张无效；可以在任何时候宣布无效"
  - id: administrative-rules
    name: 行政规章
    range:
      start:
        snippet: "## 行政规章"
      end:
        snippet: "行政规章：行政法规、法律以外的行政机关发布的规范性文件"
links: []
