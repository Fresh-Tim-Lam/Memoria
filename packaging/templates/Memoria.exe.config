<?xml version="1.0" encoding="utf-8"?>
<!--
  随包分发：由 packaging/build.py 拷贝为 Package\Memoria.exe.config。
  文件名必须是 <exe 名>.config，且与 Memoria.exe 同目录；.NET 只按这个名字读。

  为什么需要它（P06，2026-09-18）：
  zip 解压出的文件会被 Windows 打上 Mark-of-the-Web（备用数据流
  `Zone.Identifier`，ZoneId=3）。.NET Framework 的 Assembly.LoadFrom 默认拒绝
  加载来源为「Internet 区域」的程序集（HRESULT 0x80131515 "Operation is not
  supported"）。pywebview 的 WinForms 后端正是这样加载随包 pythonnet 的
  `lib/pythonnet/runtime/Python.Runtime.dll`，而 clr_loader 的原生入口会把该
  异常吞成 NULL，Python 侧只剩一句没有细节的
  「Failed to resolve Python.Runtime.Loader.Initialize」——表现为双击即崩。

  `loadFromRemoteSources` 是 .NET 专为这一场景提供的开关。本进程只加载随包
  自带的程序集（不执行用户下载的代码），故允许「远程来源」是安全且恰当的。
  这条修法优于「启动时删掉 Zone.Identifier」：不修改任何开发机 / 用户机上的
  文件元数据，也不受盘符等环境差异影响。
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
