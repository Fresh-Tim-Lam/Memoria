{
  "v": 1,
  "id": "kb-write",
  "name": "写能力（知识点 / 跳转 / 边 / 文件 / 清单）",
  "provides": {
    "tools": [
      { "tool_id": "kb.kp.create" },
      { "tool_id": "kb.kp.update" },
      { "tool_id": "kb.kp.delete" },
      { "tool_id": "kb.kp.rename" },
      { "tool_id": "kb.link.attach" },
      { "tool_id": "kb.link.detach" },
      { "tool_id": "kb.link.create" },
      { "tool_id": "kb.file.create" },
      { "tool_id": "kb.file.rename" },
      { "tool_id": "kb.file.delete" },
      { "tool_id": "kb.file.move" },
      { "tool_id": "kb.file.edit" },
      { "tool_id": "kb.manifest.rebuild" }
    ]
  },
  "permissions": {
    "read": [ "**/*.md", ".memoria/**" ],
    "write": [ "**/*.md", ".memoria/sidecars/**", ".memoria/manifest.yaml", ".memoria/pending.json" ]
  },
  "approval": { "read": "auto", "write": "confirm" }
}
