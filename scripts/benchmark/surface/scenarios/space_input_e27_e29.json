        {
          "op": "sleep",
          "ms": 500
        },
        {
          "op": "eval",
          "expr": "(function(){var bs=[].slice.call(document.querySelectorAll('#preview .-src-block'));for(var i=0;i<bs.length;i++){if((bs[i].textContent||'').indexOf('plainword')>=0){var w=document.createTreeWalker(bs[i],NodeFilter.SHOW_TEXT,null),last=null,n;while(n=w.nextNode())last=n;var r=document.createRange();r.setStart(last,last.nodeValue.length);r.collapse(true);var s=getSelection();s.removeAllRanges();s.addRange(r);document.getElementById('preview').focus();return {idx:i,last:last.nodeValue,ws:getComputedStyle(bs[i]).whiteSpace};}}return null;})()"
        },
