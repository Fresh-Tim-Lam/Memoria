{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memoria://graph/contracts/datasource/v1",
  "title": "DataSource 只读投影（I-01）",
  "description": "事实只来自 md + .memoria sidecar/manifest（S6-1）；本结构是派生投影，不写 sidecar（D-3）。",
  "x-failure-code": "GRAPH_INTERNAL",
  "x-contract-sources": {
    "S6-contract-v1.md": "40f12e5fd5946c8cc4ebdb71800579d3e9098f74ef7381ad65a2e51f389db82b",
    "S6-ADDENDUM-1.md": "f9918dfdc0586b297e06f4632f0a7313b16f14e527c475fde04dfe9eba7a48dd",
    "S6-ADDENDUM-2.md": "45b99ab2f3235515581153400533b633101c77fde4f3eb7a6a638b70300531e7"
  },
  "type": "object",
  "required": ["status", "canonical_id", "e_relation_min", "kps", "edges"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "empty_nosemantic"]
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "e_relation_min": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": ["contain(structural)", "contain(semantic)", "reference", "extend"]
      }
    },
    "kps": {
      "type": "array",
      "items": {"$ref": "#/$defs/kp"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "kp": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["kp", "cluster"]},
        "name": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "file": {"type": ["string", "null"]},
        "range_ok": {"type": "boolean"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "edge": {
      "type": "object",
      "required": ["type", "source_id", "targets"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["contain", "reference", "extend"]},
        "source_id": {"type": "string", "minLength": 1},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "derived": {"type": "boolean"},
        "origin": {"type": "string", "enum": ["range", "link", "sidecar_edge"]},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "no_build": {"type": "boolean"},
        "derived_by": {"type": "string", "enum": ["author", "system_range", "system_link"]}
      }
    }
  }
}
