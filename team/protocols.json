      "history": [
        {
          "version": { "major": 1, "minor": 0 },
          "changedAt": "2026-10-30T11:00:00+08:00",
          "change": "additive",
          "note": "登记既有约束（插件 v9 R-06 examples[0]）：peer 直发 hops 上限（配置 peerMessageMaxHops，默认 4），超限 TEAM_PEER_HOPS_EXCEEDED。证据：DSH 测试 5>4 被拒；dispatch-log 608 条 message。"
        }
      ],
      "checks": [{ "id": "TEAM_PEER_HOPS_EXCEEDED", "kind": "machine" }]
    },
    {
      "id": "evidence-on-complete",
      "version": { "major": 1, "minor": 0 },
      "title": "任务收口必须绑定可验证产物",
      "origin": "plugin",
      "enforcement": "refuse",
      "constraints": [
        {
          "type": "semantics",
          "assert": "complete-requires-evidence",
          "params": { "artifactRequired": true },
          "description": "complete 必须带 evidence[] 或 no_artifact_reason"
        },
        {
          "type": "format",
          "field": "evidence",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "pattern": "^[^/].+" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      ],
      "scope": { "team": true, "groups": [], "taskWorkKinds": [] },
      "appliesTo": { "actions": ["task.complete"], "pipeKinds": [], "channels": [] },
      "owner": { "role": "steward" },
      "source": { "path": "docs/guides/team-protocols.md", "anchor": "P-02 evidence-on-complete" },
      "status": "active",
      "createdAt": "2026-10-30T11:00:00+08:00",
      "history": [
        {
          "version": { "major": 1, "minor": 0 },
          "changedAt": "2026-10-30T11:00:00+08:00",
          "change": "additive",
          "note": "登记 v8 起既有拒绝：task.complete 需 evidence[] 或 no_artifact_reason；依据 AGENTS §0.5 L3（关闭任务必须有 evidence）。证据：插件 TEAM_TASK_EVIDENCE_REQUIRED。"
        }
      ],
      "checks": [{ "id": "TEAM_TASK_EVIDENCE_REQUIRED", "kind": "machine" }]
    },
